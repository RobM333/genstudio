# Copy this file to .env.local for running on your own computer.
# On Netlify, add these under Site configuration -> Environment variables instead.
# NEVER commit real values to git or paste them in chat.

# Your fal.ai API key. Leave empty to run in free demo mode.
FAL_KEY=

# A password visitors must type to use the app. Required before real
# generation is switched on, so strangers can't spend your fal.ai credit.
APP_PASSWORD=
